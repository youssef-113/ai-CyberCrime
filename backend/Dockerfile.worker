FROM python:3.11-slim

WORKDIR /app

# ── System Dependencies (full — OCR, PDF generation, Arabic fonts) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # PaddleOCR BLAS
    liblapack-dev \
    libopenblas-dev \
    # Arabic font rendering
    fonts-dejavu-core \
    fonts-noto-core \
    # PDF generation
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-xlib-2.0-0 \
    libffi-dev \
    shared-mime-info \
    # poppler for PDF processing
    poppler-utils \
    # Health check
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python Dependencies (full ML stack) ──
COPY requirements-worker.txt requirements-api.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-worker.txt

# ── Application Code ──
COPY . .

# ── Run Celery Worker ──
# Command is provided by docker-compose.yml
CMD ["celery", "-A", "services.common.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
