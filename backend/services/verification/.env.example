# Verification Service – Local Development
# Copy this to .env and fill in your key

# Required: Groq API key
GROQ_API_KEY=gsk_xxx-your-key-here

# Optional: LLM model (default: llama-3.3-70b-versatile)
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: Override API endpoint (default: Groq)
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Supabase (optional – if set, data is persisted to cloud; otherwise SQLite)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: Override SQLite DB path (default: data/verification.db)
# VERIFICATION_DB_PATH=data/verification.db
