# ═══════════════════════════════════════════════════════════════════════════
#  ACEB — Railway Production Environment
#  Copy these values into your Railway dashboard environment variables.
# ═══════════════════════════════════════════════════════════════════════════

# ── HuggingFace (for model downloads — faster with a token) ──────
HF_TOKEN=

# ── LLM: Groq (primary — fast inference) ─────────────────────────
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT=20
LLM_PROVIDER=groq
FALLBACK_API_KEY=

# ── LLM: Ollama (fallback, not needed on Railway) ────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=5

# ── Vector DB: ChromaDB Cloud ────────────────────────────────────
CHROMA_CLIENT_TYPE=cloud
CHROMA_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=egyptian_law
CHROMA_COLLECTION=egyptian_law

# ── RAG Pipeline (production-optimized) ──────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=200
PARENT_CHUNK_SIZE=1024

# Embedding: multilingual-e5-small handles Arabic + English natively
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Reranker disabled by default (English-only cross-encoder models).
# Enable if you add an Arabic-capable cross-encoder.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5

# Query transforms via Groq (fast: ~200ms per transform)
HYDE_ENABLED=true
RAG_FUSION_ENABLED=true
RAG_FUSION_QUERIES=3
STEP_BACK_ENABLED=false

# Semantic cache (needs Redis on Railway)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600

# Hybrid retrieval (BM25 boosts Arabic keyword matches)
RETRIEVER_TOP_K=20
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
MIN_VECTOR_SIMILARITY=0.0

# Multi-tenant (separate collections per user)
MULTI_TENANT_ENABLED=true
TENANT_NAMESPACE_PREFIX=tenant_

# Bump CACHE_VERSION to invalidate all cached responses
CACHE_VERSION=v2

# Observability
OBSERVABILITY_ENABLED=true
FAITHFULNESS_THRESHOLD=0.7

# Ingestion
INGESTION_BATCH_SIZE=100

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── JWT Auth ─────────────────────────────────────────────────────
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_DISABLED=false

# ── Redis (Railway Redis plugin) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Monolith base URL (internal — all services in same container) ──
# Gateway proxies to itself via localhost to avoid public-internet round-trips.
MONOLITH_BASE_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────────
# Frontend Vercel domain + local dev
CORS_ORIGINS=https://ai-cyber-crime.vercel.app,http://localhost:3000

# ── Service URLs ─────────────────────────────────────────────────
# All sub-services are mounted in-process in the same FastAPI app.
# No need to override these unless running services separately.
# OCR_SERVICE_URL=http://localhost:8000/ocr
# CLASSIFIER_SERVICE_URL=http://localhost:8000/classifier
# RAG_SERVICE_URL=http://localhost:8000/rag
# VERIFICATION_SERVICE_URL=http://localhost:8000/verification
# PDF_SERVICE_URL=http://localhost:8000/pdf
# CHATBOT_SERVICE_URL=http://localhost:8000/chat
