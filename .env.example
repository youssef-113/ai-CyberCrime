# ============================================================
# ACEB — Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# ── LLM: Ollama (primary, local, free) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=300
LLM_PROVIDER=ollama

# ── LLM: Groq (cloud fallback + OCR understanding layer) ────
# Get your key: https://console.groq.com/
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Timeout for the Groq understanding layer call (seconds)
GROQ_TIMEOUT=20

# Second Groq key for rate-limit rotation
FALLBACK_API_KEY=

# ── Supabase PostgreSQL ──────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── JWT Auth ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-strong-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true to skip auth checks in development only
AUTH_DISABLED=false

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Service URLs (used by API gateway internally) ────────────
# Monolith: gateway proxies to its own in-process mounts on the `backend` host.
# For non-docker local dev, set these to http://localhost:8000/<mount> instead.
OCR_SERVICE_URL=http://backend:8000/ocr
CLASSIFIER_SERVICE_URL=http://backend:8000/classifier
RAG_SERVICE_URL=http://backend:8000/rag
VERIFICATION_SERVICE_URL=http://backend:8000/verification
PDF_SERVICE_URL=http://backend:8000/pdf
CHATBOT_SERVICE_URL=http://backend:8000/chat

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Redis ────────────────────────────────────────────────────
# DB 0 = general app cache + OCR cache + semantic cache
# DB 1 = Celery broker
# DB 2 = Celery result backend
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_TTL=3600

# ── OCR Service ──────────────────────────────────────────────
# Engine confidence thresholds (0.0 – 1.0)
CHANDRA_CONFIDENCE_THRESHOLD=0.85
PADDLE_CONFIDENCE_THRESHOLD=0.80
# Security limits
MAX_FILE_SIZE_BYTES=10485760     # 10 MB
MAX_IMAGE_DIMENSION=8000         # pixels (longest side)
MAX_PDF_PAGES=20
OCR_TIMEOUT=30                   # seconds before aborting OCR
MAX_BATCH_FILES=10
# Redis caching for OCR results
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL=3600               # seconds

# ── Vector DB (ChromaDB Cloud) ──────────────────────────────
CHROMA_API_KEY=your-chroma-api-key
CHROMA_CLOUD_TENANT=your-chroma-tenant-id
CHROMA_CLOUD_DATABASE=egyptian_law
CHROMA_COLLECTION=egyptian_law

# ── RAG Pipeline ─────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=200
PARENT_CHUNK_SIZE=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600
MULTI_TENANT_ENABLED=true
HYDE_ENABLED=true
RAG_FUSION_ENABLED=true
STEP_BACK_ENABLED=false
RAG_FUSION_QUERIES=3
RETRIEVER_TOP_K=20
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
MIN_VECTOR_SIMILARITY=0.5
OBSERVABILITY_ENABLED=true
FAITHFULNESS_THRESHOLD=0.7

# ── Logging / Debug ──────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
