# ============================================================
# ACEB — Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# ── LLM: Groq (primary for production — fast inference) ───────
# Get your key: https://console.groq.com/
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT=20
LLM_PROVIDER=groq                           # "groq" | "ollama"

# ── LLM: Ollama (local dev fallback) ──────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=5
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=300

# Second LLM key for rate-limit rotation
FALLBACK_API_KEY=

# ── Supabase PostgreSQL ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-strong-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_DISABLED=false

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://ai-cyber-crime.vercel.app

# ── Monolith base URL (self-referencing for internal HTTP) ────
# Docker: http://backend:8000
# Local:  http://localhost:8000
# Railway: http://localhost:8000 (same container)
MONOLITH_BASE_URL=http://localhost:8000

# ── Service URLs (override only if running services separately) ──
# OCR_SERVICE_URL=http://localhost:8000/ocr
# CLASSIFIER_SERVICE_URL=http://localhost:8000/classifier
# RAG_SERVICE_URL=http://localhost:8000/rag
# VERIFICATION_SERVICE_URL=http://localhost:8000/verification
# PDF_SERVICE_URL=http://localhost:8000/pdf
# CHATBOT_SERVICE_URL=http://localhost:8000/chat

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── OCR Service ──────────────────────────────────────────────
PADDLE_CONFIDENCE_THRESHOLD=0.80
MAX_FILE_SIZE_BYTES=10485760
MAX_IMAGE_DIMENSION=8000
MAX_PDF_PAGES=20
OCR_TIMEOUT=30
MAX_BATCH_FILES=10
OCR_CACHE_ENABLED=true
OCR_CACHE_TTL=3600

# ── Vector DB ─────────────────────────────────────────────────
# "persistent" for local dev, "cloud" for production
CHROMA_CLIENT_TYPE=persistent

# Local persistent (used when CHROMA_CLIENT_TYPE=persistent)
CHROMA_PERSIST_DIR=data/law_db

# ChromaDB Cloud (used when CHROMA_CLIENT_TYPE=cloud)
# Sign up at https://trychroma.com to get API key + tenant
CHROMA_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=egyptian_law
CHROMA_COLLECTION=egyptian_law

# ── RAG Pipeline ─────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=200
PARENT_CHUNK_SIZE=1024
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# Cross-encoder reranker (improves precision)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RERANKER_TOP_N=5

# Query transforms (uses LLM provider — Groq is fast, Ollama is slow)
HYDE_ENABLED=true
RAG_FUSION_ENABLED=true
RAG_FUSION_QUERIES=3
STEP_BACK_ENABLED=false

# Semantic cache (requires Redis)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600

# Hybrid retrieval: vector + BM25 keyword boost
RETRIEVER_TOP_K=20
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
MIN_VECTOR_SIMILARITY=0.0

# Multi-tenant
MULTI_TENANT_ENABLED=true
TENANT_NAMESPACE_PREFIX=tenant_

# Observability
OBSERVABILITY_ENABLED=true
FAITHFULNESS_THRESHOLD=0.7

# Ingestion
INGESTION_BATCH_SIZE=100

# ── HuggingFace (for model downloads — get token at https://hf.co/settings/tokens) ──
HF_TOKEN=

# ── Logging / Debug ──────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
