# Cybercrime AI - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: LLM API Configuration
# ============================================
# Primary: Ollama (local, free, no API key needed)
# Model: qwen2.5:3b - lightweight multilingual model, good for Arabic/English legal queries
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=300
LLM_PROVIDER=ollama

# Optional: Groq API fallback (cloud, requires API key)
# Get your API key from: https://console.groq.com/
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Second Groq API key for rate limit handling
FALLBACK_API_KEY=

# ============================================
# Supabase PostgreSQL Configuration
# ============================================
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================
# JWT Authentication Configuration
# ============================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-strong-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "true" to disable auth (development only)
AUTH_DISABLED=false

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Service URLs (Docker internal networking)
# These are used by docker-compose
# ============================================
OCR_SERVICE_URL=http://ocr:8001
CLASSIFIER_SERVICE_URL=http://classifier:8002
RAG_SERVICE_URL=http://rag:8003
VERIFICATION_SERVICE_URL=http://verification:8004
PDF_SERVICE_URL=http://pdf-gen:8005
CHATBOT_SERVICE_URL=http://chatbot:8006

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:8000

# ============================================
# Vector Database (Qdrant - Production)
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=egyptian_law
VECTOR_SIZE=384

# ============================================
# Redis (Semantic Cache + Celery Broker)
# ============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================
# RAG Pipeline Configuration
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=200
PARENT_CHUNK_SIZE=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600
MULTI_TENANT_ENABLED=true
HYDE_ENABLED=true
RAG_FUSION_ENABLED=true
STEP_BACK_ENABLED=false
RAG_FUSION_QUERIES=3
RETRIEVER_TOP_K=20
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
MIN_VECTOR_SIMILARITY=0.5
OBSERVABILITY_ENABLED=true
FAITHFULNESS_THRESHOLD=0.7

# ============================================
# Development Settings
# ============================================
DEBUG=false
LOG_LEVEL=INFO
