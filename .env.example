# Cybercrime AI - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: LLM API Configuration
# ============================================
# Get your API key from: https://console.anthropic.com/
LLM_API_KEY=sk-ant-your-api-key-here
LLM_MODEL=claude-3-haiku-20240307

# Optional: OpenAI alternative (if not using Claude)
# OPENAI_API_KEY=sk-your-openai-key

# ============================================
# Service URLs (Docker internal networking)
# These are used by docker-compose
# ============================================
OCR_SERVICE_URL=http://ocr:8001
CLASSIFIER_SERVICE_URL=http://classifier:8002
RAG_SERVICE_URL=http://rag:8003
VERIFICATION_SERVICE_URL=http://verification:8004
PDF_SERVICE_URL=http://pdf-gen:8005

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:8000

# ============================================
# Vector Database (Qdrant)
# ============================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ============================================
# Development Settings
# ============================================
DEBUG=false
LOG_LEVEL=INFO

# --- IGNORE ---