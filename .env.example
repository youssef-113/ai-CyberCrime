# Cybercrime AI - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: LLM API Configuration
# ============================================
# Get your API key from: https://console.anthropic.com/
LLM_API_KEY=sk-ant-your-api-key-here
LLM_MODEL=claude-3-haiku-20240307

# Optional: OpenAI alternative (if not using Claude)
# OPENAI_API_KEY=sk-your-openai-key

# ============================================
# Supabase PostgreSQL Configuration
# ============================================
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================
# JWT Authentication Configuration
# ============================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-strong-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "true" to disable auth (development only)
AUTH_DISABLED=false

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Service URLs (Docker internal networking)
# These are used by docker-compose
# ============================================
OCR_SERVICE_URL=http://ocr:8001
CLASSIFIER_SERVICE_URL=http://classifier:8002
RAG_SERVICE_URL=http://rag:8003
VERIFICATION_SERVICE_URL=http://verification:8004
PDF_SERVICE_URL=http://pdf-gen:8005

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:8000

# ============================================
# Vector Database (ChromaDB)
# ============================================
CHROMA_DATA_PATH=./data/law_db

# ============================================
# Development Settings
# ============================================
DEBUG=false
LOG_LEVEL=INFO

# --- IGNORE ---